# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./study_planner.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/study_planner_db

# Security & JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI / LLM Configuration
# If omitted or invalid, the platform gracefully switches to intelligent deterministic fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

